---
interface Props {
  current: string;
  article?: boolean;
}

const { current, article = false } = Astro.props;
---

<nav class="breadcrumb field-guide-breadcrumb" aria-label="Breadcrumb">
  <ol>
    <li><a href="/" class="text-link">Home</a></li>
    {article && <li><a href="/field-guide/" class="text-link">Field Guide</a></li>}
    <li aria-current="page">{current}</li>
  </ol>
</nav>
