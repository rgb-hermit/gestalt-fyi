---
interface Props {
  class: string;
  href: string;
  parent: string;
  current: string;
}

const { class: placement, href, parent, current } = Astro.props;
---

<nav class:list={["breadcrumb", placement]} aria-label="Breadcrumb">
  <ol>
    <li>
      <a href={href} class="text-link breadcrumb-back">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 12H5m6-6-6 6 6 6" />
        </svg>
        {parent}
      </a>
    </li>
    <li aria-current="page">{current}</li>
  </ol>
</nav>
