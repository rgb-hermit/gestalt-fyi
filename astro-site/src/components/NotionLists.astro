---
import NotionRichText from "./notion-rich-text.astro";
import type { NotionBlock } from "../lib/notion";

interface Props { blocks: NotionBlock[]; }
const { blocks } = Astro.props;
const kind = (block: NotionBlock) => block.type === "numbered_list_item" ? "ol" : block.type === "to_do" ? "tasks" : "ul";
const groups: { type: string; items: NotionBlock[] }[] = [];
for (const block of blocks) {
  const type = kind(block);
  const previous = groups[groups.length - 1];
  if (previous?.type === type) previous.items.push(block);
  else groups.push({ type, items: [block] });
}
---
{groups.map((group) => (
  group.type === "ol" ? (
    <ol class="notion-list notion-numbered-list">
      {group.items.map((item) => (
        <li>
          <NotionRichText items={item.numbered_list_item?.rich_text ?? []} />
          {item.children?.length ? <Astro.self blocks={item.children} /> : null}
        </li>
      ))}
    </ol>
  ) : group.type === "tasks" ? (
    <ul class="notion-list notion-task-list">
      {group.items.map((item) => (
        <li>
          <input type="checkbox" checked={Boolean(item.to_do?.checked)} disabled aria-label={(item.to_do?.rich_text ?? []).map((part: {plain_text:string}) => part.plain_text).join("") || "Task"} />
          <span><NotionRichText items={item.to_do?.rich_text ?? []} /></span>
          {item.children?.length ? <Astro.self blocks={item.children} /> : null}
        </li>
      ))}
    </ul>
  ) : (
    <ul class="notion-list notion-bulleted-list">
      {group.items.map((item) => (
        <li>
          <NotionRichText items={item.bulleted_list_item?.rich_text ?? []} />
          {item.children?.length ? <Astro.self blocks={item.children} /> : null}
        </li>
      ))}
    </ul>
  )
))}
