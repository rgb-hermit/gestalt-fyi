---
interface RichTextItem {
  plain_text: string;
  href?: string | null;
  annotations?: {
    bold?: boolean;
    italic?: boolean;
    strikethrough?: boolean;
    underline?: boolean;
    code?: boolean;
  };
}

interface Props {
  items: RichTextItem[];
}

const { items = [] } = Astro.props;
---

{items.map((item) => {
  const annotations = item.annotations ?? {};
  const content = item.plain_text;

  const formatted = annotations.code
    ? <code>{content}</code>
    : annotations.bold && annotations.italic
      ? <strong><em>{content}</em></strong>
      : annotations.bold
        ? <strong>{content}</strong>
        : annotations.italic
          ? <em>{content}</em>
          : annotations.strikethrough
            ? <del>{content}</del>
            : annotations.underline
              ? <u>{content}</u>
              : content;
const citation = /^\[(\d+)\]$/.exec(content.trim());

const parts = content.split(/(\[\d+\])/g);

if (parts.length > 1 && !item.href) {
  return parts.map((part) => {
    const match = /^\[(\d+)\]$/.exec(part);

    if (match) {
      const number = match[1];

      return (
        <sup class="article-citation">
          <a
            href={`#reference-${number}`}
            aria-label={`Jump to reference ${number}`}
          >
            [{number}]
          </a>
        </sup>
      );
    }

    return part;
  });
}
  return item.href
    ? <a href={item.href}>{formatted}</a>
    : formatted;
})}