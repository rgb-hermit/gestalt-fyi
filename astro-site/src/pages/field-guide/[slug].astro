---
import Layout from '../../layouts/Layout.astro';
import { references } from '../../data/references';

export function getStaticPaths() {
  return [
    {
      params: { slug: 'accessibility' },
      props: { title: 'Accessibility' },
    },
  ];
}

const { title } = Astro.props;
---

<Layout>
  <link rel="stylesheet" href="/field-guide.css" />
    <main class="field-guide-article">
      <div class="article-content">
        <a href="/field-guide/" class="article-back">
          <span class="article-back-icon" aria-hidden="true">←</span>
          <span class="article-back-label">Field Guide</span>
        </a>

        <header class="article-header">
          <p class="article-category">FIELD GUIDE · FOUNDATIONS</p>
          <h1>{title}</h1>
          <p class="article-summary">
            Exploring accessibility as a fundamental consideration in how we
            design and build digital experiences.
          </p>
          <div class="article-artwork" aria-hidden="true"></div>
        </header>
<div class="article-layout">
<aside class="article-sidebar">
  <nav class="article-toc" aria-label="On this page">
  <p class="toc-label">ON THIS PAGE</p>
  <ol>
    <li>
      <a href="#beyond-compliance">Beyond compliance</a>
    </li>
    <li>
      <a href="#designing-for-variation">Designing for variation</a>
    </li>
  </ol>
</nav>
<section class="article-references-preview" aria-labelledby="references-preview-heading">
  <h2 id="references-preview-heading">REFERENCES</h2>

  <ol>
    {references.map((reference) => (
  <li
  id={reference.id}
  class={reference.cited ? 'cited-reference' : 'uncited-reference'}
  >
    {reference.cited && reference.number !== null ? (
      <>
        <a
          class="reference-marker"
          href={`#${reference.id}`}
          aria-label={`Go to reference ${reference.number}`}
        >
          [{reference.number}]
        </a>
        <span>{reference.author}, {reference.year}</span>
      </>
    ) : (
      <span>{reference.author}, {reference.year}</span>
    )}
  </li>
))}
  </ol>
</section>
</aside>

          <div class="article-body">
        <p>
          Accessibility is the practice of designing digital experiences
          that people with a wide range of abilities, circumstances and
          technologies can use.
        </p>

        <p>
          It is not a separate layer of design, or a final check before
          something goes live. Accessibility shapes decisions about
          structure, interaction, language and presentation throughout
          the design process.
        </p>

        <h2 id="beyond-compliance">Beyond compliance</h2>

        <p>
          Standards and guidelines provide an important foundation,<sup><a id="citation-1" href="#reference-1" aria-label="Go to reference 1">[1]</a></sup> but
          accessibility is ultimately about the people using what we make.
          A technically compliant interface can still be confusing,
          exhausting or difficult to navigate.
        </p>

        <p>
          Considering accessibility early helps reveal assumptions about
          how people perceive information, make decisions and interact
          with technology.
        </p>
        <figure class="article-figure">
          <div
            class="article-image-placeholder"
            role="img"
            aria-label="Temporary abstract illustration using overlapping shapes in the gestalt.fyi colour palette"
          ></div>

          <figcaption>
            Exploring variation through overlapping forms. Placeholder artwork for layout testing.
          </figcaption>
        </figure>
          <aside class="article-callout" aria-label="Design consideration">
            <p class="article-callout-label">DESIGN CONSIDERATION</p>
            <p>
              Accessibility isn't a fixed set of user needs. Context, environment
              and individual circumstances can all change how someone experiences
              an interface.
            </p>
          </aside>
        <h2="designing-for-variation">Designing for variation</h2>

        <p>
          People experience digital products in different ways. Some use
          assistive technologies, while others navigate using a keyboard,
          enlarge text, adjust contrast or interact in challenging
          environments.
        </p>

        <p>
          Designing for this variation encourages more flexible,
          resilient experiences rather than assuming a single ideal user
          or way of interacting.
        </p>
      <section class="article-related" aria-labelledby="related-heading">
          <h2 id="related-heading">Related concepts</h2>
          <ul>
            <li>Inclusive design</li>
            <li>Usability</li>
            <li>Universal design</li>
          </ul>
      </section>
      </div>
    </div>
  </div>
  </main>
</Layout>