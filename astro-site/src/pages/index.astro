---
import Layout from '../layouts/Layout.astro';
---

<Layout>
<div class="page-shell">

    <header class="site-header">
      <a class="brand" href="/" aria-label="gestalt.fyi home">
        <span class="brand-name">gestalt.fyi</span>

        <!-- Decorative asterisk -->
        <svg
          class="brand-mark"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 16 16"
          aria-hidden="true"
        >
          <path
            d="M8 1.5v13M1.5 8h13M3.4 3.4l9.2 9.2M12.6 3.4l-9.2 9.2"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
            stroke-linecap="round"
          />
        </svg>

        <span class="bracketed">[KAT BAK]</span>
      </a>

      
    <span class="site-status">
      <span>PEOPLE</span>

      <svg
        class="footer-chevron"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 12 16"
        aria-hidden="true"
      >
        <path
          d="m4 3.5 4 4.5-4 4.5"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>

      <span>TECHNOLOGY</span>
    </span>

    </header>

    <main class="hero">
      <!-- Decorative wavy line -->
      <svg
        class="hero-wave"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 480 12"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path
          d="M1 6
             C11 6 11 2 21 2
             S31 10 41 10
             S51 2 61 2
             S71 10 81 10
             S91 2 101 2
             S111 10 121 10
             S131 2 141 2
             S151 10 161 10
             S171 2 181 2
             S191 10 201 10
             S211 2 221 2
             S231 10 241 10
             S251 2 261 2
             S271 10 281 10
             S291 2 301 2
             S311 10 321 10
             S331 2 341 2
             S351 10 361 10
             S371 2 381 2
             S391 10 401 10
             S411 2 421 2
             S431 10 441 10
             S451 2 461 2
             S471 6 479 6"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
          stroke-linecap="round"
        />
      </svg>

      <h1 class="hero-title">
        People before technology.<br />
        Technology for people.
      </h1>

      <div class="hero-copy">
        <p>
          I'm a product designer trying to make sense of the messy,
          complicated business of being human: how people think and
          behave, why systems work the way they do, and whether the
          technology we're building actually makes anything better.
          I like questioning assumptions, connecting the dots, and
          looking at problems from different angles.
        </p>

        <p>
          I work across product strategy and design, help bridge the
          gap between design and development, and occasionally speak
          about UX and technology.
        </p>
      </div>

      <div class="contact">
        <button
          class="contact-trigger"
          id="contact-trigger"
          type="button"
          aria-expanded="false"
          aria-controls="contact-details"
        >
          <span>Get in touch</span>

          <!-- External-style arrow, used as a visual accent -->
          <svg
            class="external-arrow"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 16 16"
            aria-hidden="true"
          >
            <path
              d="M5 11 11 5M5 5h6v6"
              fill="none"
              stroke="currentColor"
              stroke-width="1.1"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>

        <div
          class="contact-details"
          id="contact-details"
          hidden
        >
          <p class="contact-label">EMAIL</p>

          <div class="contact-actions">
            <span id="email-address" class="email-address"></span>

            <button
              class="copy-email"
              id="copy-email"
              type="button"
            >
              Copy email
            </button>
          </div>

          <p
            class="contact-feedback"
            id="contact-feedback"
            role="status"
            aria-live="polite"
          ></p>
        </div>
      </div>
    
    </main>

    
<footer class="site-footer">

  <!-- Future site sections -->
  <nav class="footer-navigation" aria-label="Future site sections">
    <h2 class="footer-heading">Perpetually under construction</h2>
    <ul class="footer-links">
      <li>User Experience Field Guide</li>
      <li>Résumé</li>
      <li>Blog</li>
      <li>Experiments</li>
    </ul>
  </nav>

  <!-- Acknowledgement of Country -->
  <section
    class="footer-acknowledgement"
    aria-labelledby="footer-acknowledgement-heading"
  >
    <h2 id="footer-acknowledgement-heading" class="footer-heading">
      Acknowledgement of Country
    </h2>
    <p>
      I acknowledge the traditional custodians of the waters and lands on which I live and work. I pay my respects to elders past
      and present, and recognise the continuing connection of
      Aboriginal and Torres Strait Islander peoples to Country,
      culture and community. Indigenous sovereignty has never been
      ceded. Always was, and always will be Aboriginal land.
    </p>
  </section>

  <!-- Identity and social links -->
  <div class="footer-identity">
    <div class="footer-identity-line">
      <!-- Original happytheythem SVG -->
      <svg
        class="footer-smile"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 16 16"
        aria-hidden="true"
      >
        <circle cx="5" cy="5.5" r="0.6" fill="currentColor" />
        <circle cx="11" cy="5.5" r="0.6" fill="currentColor" />
        <path
          d="M3.5 8.5c1 2.2 2.5 3.3 4.5 3.3s3.5-1.1 4.5-3.3"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
          stroke-linecap="round"
        />
      </svg>
      <span>© <span id="copyright-year">2026</span></span>
      <span class="footer-separator" aria-hidden="true">·</span>
      <span class="bracketed">[KAT BAK]</span>
    </div>
    
  <div class="footer-socials" aria-label="Social profiles">
    <!-- LinkedIn -->
    <a
      class="social-link"
      href="https://www.linkedin.com/in/butwhoiskat/"
      aria-label="LinkedIn (opens in a new tab)"
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg
  viewBox="0 0 24 24"
  aria-hidden="true"
  fill="currentColor"
>
  <path
    d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.35V9h3.414v1.561h.049c.476-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286ZM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124Zm1.782 13.019H3.555V9h3.564v11.452ZM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003Z"
  />
</svg>
    </a>

    <!-- X -->
    <a
      class="social-link"
      href="https://x.com/gestalt_fyi"
      aria-label="X (opens in a new tab)"
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg
        viewBox="0 0 24 24"
        aria-hidden="true"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M4 3h4l12 18h-4L4 3Z" />
        <path d="M20 3 4 21" />
      </svg>
    </a>

    <!-- GitHub: inactive -->
      <span 
        class="social-inactive" 
        role="img"
        aria-label="Github - coming soon"
        title="GitHub — coming soon"
      >
      <svg
        viewBox="0 0 24 24"
        aria-hidden="true"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M9 19c-4.5 1.5-4.5-2.5-6-3m12 5v-3.4a3 3 0 0 0-.8-2.3c2.7-.3 5.5-1.3 5.5-6A4.7 4.7 0 0 0 18.4 6a4.3 4.3 0 0 0-.1-3s-1 0-3.1 1.7a10.5 10.5 0 0 0-6.4 0C6.7 3 5.7 3 5.7 3a4.3 4.3 0 0 0-.1 3 4.7 4.7 0 0 0-1.3 3.3c0 4.7 2.8 5.7 5.5 6a3 3 0 0 0-.8 2.3V21" />
      </svg>
    </span>
  </div>

  </div>
</footer>

  </div>

  <script>
    (() => {
      const contactTrigger = document.getElementById("contact-trigger");
      const contactDetails = document.getElementById("contact-details");
      const emailAddress = document.getElementById("email-address");
      const copyEmail = document.getElementById("copy-email");
      const contactFeedback = document.getElementById("contact-feedback");

      // Assemble the address at runtime rather than writing it
      // as a complete address in the HTML.
      const email = ["hello", "gestalt.fyi"].join("@");

      contactTrigger.addEventListener("click", () => {
        const isExpanded =
          contactTrigger.getAttribute("aria-expanded") === "true";

        contactTrigger.setAttribute("aria-expanded", String(!isExpanded));
        contactDetails.hidden = isExpanded;
        contactFeedback.textContent = "";

        if (!isExpanded) {
          emailAddress.textContent = email;
        }
      });

      copyEmail.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(email);
          contactFeedback.textContent = "Email address copied.";
        } catch (error) {
          contactFeedback.textContent =
            "Copy isn't available here. You can select the email address and copy it manually.";
        }
      });
    })();
  </script>
  <script>
  const copyrightYear = document.getElementById("copyright-year");
  const startYear = 2026;
  const currentYear = new Date().getFullYear();

  if (copyrightYear) {
    copyrightYear.textContent =
      currentYear > startYear
        ? `${startYear}–${currentYear}`
        : String(startYear);
  }
</script>
</Layout>