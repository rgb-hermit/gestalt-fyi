---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<Layout
  title="gestalt.fyi — People before technology"
  description="Product design, human behaviour and thoughtful technology."
>
  <div class="page-shell">
    <SiteHeader />

    <main id="main-content" class="hero">
      <h1 class="hero-title">
        People before technology.
        <br />
        Technology for people.
      </h1>

      <div class="hero-copy">
        <p>
          An ongoing attempt to make sense of the messy, complicated, and often
          absurd experience of being human. Why we think the way we think, and
          do the things we do. How the systems we create inevitably shape us in
          return, and whether the technology we're building actually makes
          anything better.
        </p>

        <p>
          Connecting dots, questioning assumptions, noticing patterns. Pulling
          at threads to see where they lead, or if they lead anywhere at all.
        </p>
      </div>

      <div class="contact">
        <button
          class="contact-trigger"
          id="contact-trigger"
          type="button"
          aria-expanded="false"
          aria-controls="contact-details"
        >
          <span>Get in touch</span>

          <!-- external-style arrow, used as a visual accent -->
          <svg
            class="external-arrow"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 16 16"
            aria-hidden="true"
          >
            <path
              d="M5 11 11 5M5 5h6v6"
              fill="none"
              stroke="currentColor"
              stroke-width="1.1"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>

        <div class="contact-details" id="contact-details" hidden>
          <p class="contact-label">EMAIL</p>

          <div class="contact-actions">
            <span id="email-address" class="email-address"></span>

            <button class="copy-email" id="copy-email" type="button">
              Copy email
            </button>
          </div>

          <p
            class="contact-feedback"
            id="contact-feedback"
            role="status"
            aria-live="polite"
          ></p>
        </div>
      </div>
    </main>

    <SiteFooter />
  </div>

  <script>
    (() => {
      const contactTrigger = document.getElementById("contact-trigger");
      const contactDetails = document.getElementById("contact-details");
      const emailAddress = document.getElementById("email-address");
      const copyEmail = document.getElementById("copy-email");
      const contactFeedback = document.getElementById("contact-feedback");
      // don't initialise the contact controls if any are missing.
      if (
        !contactTrigger ||
        !contactDetails ||
        !emailAddress ||
        !copyEmail ||
        !contactFeedback
      ) {
        return;
      }

      // assemble the address at runtime rather than writing it
      // as a complete address in the HTML.
      const email = ["hello", "gestalt.fyi"].join("@");

      contactTrigger.addEventListener("click", () => {
        const isExpanded =
          contactTrigger.getAttribute("aria-expanded") === "true";

        contactTrigger.setAttribute("aria-expanded", String(!isExpanded));
        contactDetails.hidden = isExpanded;
        contactFeedback.textContent = "";

        if (!isExpanded) {
          emailAddress.textContent = email;
        }
      });

      copyEmail.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(email);
          contactFeedback.textContent = "Email address copied.";
        } catch (error) {
          contactFeedback.textContent =
            "Copy isn't available here. You can select the email address and copy it manually.";
        }
      });
    })();
  </script>
</Layout>
