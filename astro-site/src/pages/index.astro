---
import Layout from "../layouts/Layout.astro";
import home from "../content/home-copy.json";
---

<Layout
  title="gestalt.fyi / People before technology"
  description="Product design, human behaviour and thoughtful technology."
>
  <link rel="stylesheet" href="/home.css" />
  <div class="page-shell home-page">
    <div class="home-layout">
    <aside class="home-sidebar">
      <div class="home-artwork">
        <p class="home-status">Perpetually under construction</p>
        <img
          src="/images/mono-botanical.png"
          alt=""
          class="home-botanical"
          width="466"
          height="861"
        />
      </div>
      </aside>

      <nav class="home-navigation" aria-label="Main navigation">
    <a href="/" class="text-link" aria-current="page">Home</a>
  
    <a href="/field-guide/" class="text-link" target="_blank" rel="noopener noreferrer">
      Field Guide
      <svg
        class="home-external-icon"
        viewBox="0 0 24 24"
        width="12"
        height="12"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M7 17 17 7M8 7h9v9" />
      </svg>
      <span class="visually-hidden">(opens in a new tab)</span>
    </a>
  
    <span class="home-nav-soon text-link is-unavailable" tabindex="0" aria-label="Words — coming soon">
      Words
      <span class="home-nav-tooltip" aria-hidden="true">Coming soon</span>
    </span>
  
    <span class="home-nav-soon text-link is-unavailable" tabindex="0" aria-label="Experiments — coming soon">
      Experiments
      <span class="home-nav-tooltip" aria-hidden="true">Coming soon</span>
    </span>
  </nav>

    <main id="main-content" class="home-content">
     <h1 class="hero-title">
  {home.heading.split("\n").map((line, index) => (
    <Fragment>
      {index > 0 && <br />}
      {line}
    </Fragment>
  ))}
</h1>

<div class="hero-copy">
  {home.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
</div>
      
    </main>
    </div>
  </div>

</Layout>
