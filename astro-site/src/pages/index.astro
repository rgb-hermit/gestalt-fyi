---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<Layout title="gestalt.fyi — People before technology" description="Product design, human behaviour and thoughtful technology.">
<div class="page-shell">
    <SiteHeader />
    

    <main id="main-content" class="hero">
      <!-- decorative wavy line -->
      <svg
        class="hero-wave"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 480 12"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path
          d="M1 6
             C11 6 11 2 21 2
             S31 10 41 10
             S51 2 61 2
             S71 10 81 10
             S91 2 101 2
             S111 10 121 10
             S131 2 141 2
             S151 10 161 10
             S171 2 181 2
             S191 10 201 10
             S211 2 221 2
             S231 10 241 10
             S251 2 261 2
             S271 10 281 10
             S291 2 301 2
             S311 10 321 10
             S331 2 341 2
             S351 10 361 10
             S371 2 381 2
             S391 10 401 10
             S411 2 421 2
             S431 10 441 10
             S451 2 461 2
             S471 6 479 6"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
          stroke-linecap="round"
        />
      </svg>

      <h1 class="hero-title">
        People before technology.<br />
        Technology for people.
      </h1>

      <div class="hero-copy">
        <p>
          I'm a product designer trying to make sense of the messy,
          complicated business of being human: how people think and
          behave, why systems work the way they do, and whether the
          technology we're building actually makes anything better.
          I like questioning assumptions, connecting the dots, and
          looking at problems from different angles.
        </p>

        <p>
          I work across product strategy and design, help bridge the
          gap between design and development, and occasionally speak
          about UX and technology.
        </p>
      </div>

      <div class="contact">
        <button
          class="contact-trigger"
          id="contact-trigger"
          type="button"
          aria-expanded="false"
          aria-controls="contact-details"
        >
          <span>Get in touch</span>

          <!-- external-style arrow, used as a visual accent -->
          <svg
            class="external-arrow"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 16 16"
            aria-hidden="true"
          >
            <path
              d="M5 11 11 5M5 5h6v6"
              fill="none"
              stroke="currentColor"
              stroke-width="1.1"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>

        <div
          class="contact-details"
          id="contact-details"
          hidden
        >
          <p class="contact-label">EMAIL</p>

          <div class="contact-actions">
            <span id="email-address" class="email-address"></span>

            <button
              class="copy-email"
              id="copy-email"
              type="button"
            >
              Copy email
            </button>
          </div>

          <p
            class="contact-feedback"
            id="contact-feedback"
            role="status"
            aria-live="polite"
          ></p>
        </div>
      </div>
    
    </main>

  <SiteFooter />
</div>

  <script>
    (() => {
      const contactTrigger = document.getElementById("contact-trigger");
      const contactDetails = document.getElementById("contact-details");
      const emailAddress = document.getElementById("email-address");
      const copyEmail = document.getElementById("copy-email");
      const contactFeedback = document.getElementById("contact-feedback");
        // don't initialise the contact controls if any are missing.
      if (
        !contactTrigger ||
        !contactDetails ||
        !emailAddress ||
        !copyEmail ||
        !contactFeedback
      ) {
        return;
      }

      // assemble the address at runtime rather than writing it
      // as a complete address in the HTML.
      const email = ["hello", "gestalt.fyi"].join("@");

      contactTrigger.addEventListener("click", () => {
        const isExpanded =
          contactTrigger.getAttribute("aria-expanded") === "true";

        contactTrigger.setAttribute("aria-expanded", String(!isExpanded));
        contactDetails.hidden = isExpanded;
        contactFeedback.textContent = "";

        if (!isExpanded) {
          emailAddress.textContent = email;
        }
      });

      copyEmail.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(email);
          contactFeedback.textContent = "Email address copied.";
        } catch (error) {
          contactFeedback.textContent =
            "Copy isn't available here. You can select the email address and copy it manually.";
        }
      });
    })();
  </script>
</Layout>